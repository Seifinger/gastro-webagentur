# Umgebung der WIRT-APP (ein Pilotbetrieb) – NUR Namen, KEINE echten Werte.
# Ermittelt aus dem Code (scripts/wirtStart.mjs, src/wirtServer.js,
# src/kundenBenachrichtigung.js, src/sicherungExtern.js, v2/integration/telegram*.js).
#
# Auf Fly.io: Werte ausschließlich mit "fly secrets set NAME=… --app <app>" im
# eigenen Terminal setzen – nie in diese Datei, nie in Git, nie in einen Chat.
# Nicht geheime Einstellungen stehen bereits in fly.wirt.toml [env].
# Lokal (Container-Test): Werte erzeugt deploy/wirt/lokal-test.sh selbst.

# ---------- Pflicht (ohne diese startet die App nicht) ----------
# Kürzel des Betriebs (a–z, 0–9, -), muss zum Übergabe-Paket passen
BETRIEB=
# Anmeldung am Wirt-Dashboard, mindestens 12 Zeichen: openssl rand -base64 18
WIRT_PASSWORT=
# Öffentliche HTTPS-Adresse der Wirt-App, z. B. https://<app>.fly.dev
WIRT_OEFFENTLICHE_URL=
# Schlüssel der Gast-Status-Links, mindestens 32 Zeichen: openssl rand -base64 48
# (Wechsel macht alle bisherigen Status-Links ungültig)
GAST_STATUS_GEHEIMNIS=
# Steht schon in fly.wirt.toml: GASTRO_DATEN_DIR=/data, VERTRAUTER_PROXY=fly

# ---------- Dringend empfohlen ----------
# Adresse(n) der Kundenseite, kommagetrennt, ohne Schrägstrich am Ende,
# z. B. https://trattoria-probelauf.pages.dev – andere Websites werden abgewiesen
WIRT_ERLAUBTE_ORIGINS=
# Externe verschlüsselte Sicherung: "s3" (Cloudflare R2, Backblaze B2, …)
BACKUP_ZIEL=
# 32 Byte, base64: openssl rand -base64 32 – ZUSÄTZLICH offline aufbewahren,
# ohne ihn ist keine Sicherung lesbar
BACKUP_SCHLUESSEL=
# nur bei BACKUP_ZIEL=s3 (R2: Endpoint https://<konto-id>.r2.cloudflarestorage.com, Region auto)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ZUGANG=
BACKUP_S3_GEHEIM=
# optional: Ordner im Bucket (Standard: keiner)
BACKUP_S3_PRAEFIX=
# Steht schon in fly.wirt.toml: BACKUP_UHRZEIT=03:30, BACKUP_BEHALTEN_TAGE=30, BACKUP_MINDESTENS=7

# ---------- Optional: E-Mail an Gäste (Resend) ----------
RESEND_API_KEY=
# verifizierte Absenderadresse, z. B. "Trattoria <bestellung@deine-domain.de>"
GAST_EMAIL_ABSENDER=
GAST_EMAIL_ANTWORT_AN=

# ---------- Optional: Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# nur für den Modus „Zwei eigene Bots“
TELEGRAM_BOT_TOKEN_RESERVIERUNG=
TELEGRAM_BOT_NAME_RESERVIERUNG=
TELEGRAM_BOT_TOKEN_BESTELLUNG=
TELEGRAM_BOT_NAME_BESTELLUNG=

# ---------- Optional: Web-Push aufs Wirt-Handy ----------
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------- Nur für lokale Tests – auf Fly NIE setzen ----------
# RESEND_API_BASIS / TELEGRAM_API_BASIS lenken auf lokale Test-Empfänger um.
