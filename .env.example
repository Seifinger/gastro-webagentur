# Kopiere diese Datei zu ".env" und trage deinen echten API-Key ein.
# Anleitung dazu steht in der README.md.
GOOGLE_PLACES_API_KEY=dein_api_key_hier

# Optional: eigene Domain der veroeffentlichten Entwuerfe
# SITE_BASE_URL=https://deine-domain.de

# Optional: Name unter den Anschreiben-Entwuerfen im Dashboard
# ABSENDER_NAME=Julian Seifinger

# Fuer die Prompt-basierten Textvorschlaege im Bearbeiten-Dashboard
# (public/bearbeiten.html). Ohne diesen Key schlaegt nur dieses eine Feature
# fehl, alles andere funktioniert weiter. Key erzeugen: https://console.anthropic.com/
ANTHROPIC_API_KEY=dein_anthropic_api_key_hier
